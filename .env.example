# Kafka 
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=cve_events

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=cve_analysis_dev
MONGODB_COLLECTION=cve_events

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=cve_analysis_wh
SNOWFLAKE_DATABASE=cve_analysis

# NVD API 
NVD_API_KEY=
NVD_RESULTS_PER_PAGE=100


LOG_LEVEL=INFO

# Spark driver heap for the batch ETL. Measured on the eight-year run of
# 282,755 records: 1g and 2g fail with OutOfMemoryError, 3g upwards completes.
# 4g is one step of headroom above that floor. Raise it for larger datasets;
# lower it if something else on the machine needs the RAM. In local[*] mode the
# executor shares the driver JVM, so there is no separate executor heap.
SPARK_DRIVER_MEMORY=4g
